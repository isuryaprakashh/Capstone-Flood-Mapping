# ===== Database =====
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=capstone_flood_mapping

# ===== FastAPI Server =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
USE_STUB=false

# ===== Model Checkpoints =====
# weights/ holds the final Colab run (fusion epoch 48, unet epoch 26);
# the .pth files in checkpoints/ are an older, weaker run.
MODEL_CHECKPOINT_DIR=./weights
O2_BASELINE_WEIGHTS=./weights/unet_net_best.pth
O3_FUSION_WEIGHTS=./weights/fusion_net_best.pth

# ===== Compute =====
CUDA_VISIBLE_DEVICES=0
WANDB_PROJECT=capstone-flood-mapping

# ===== Dataset =====
SPACENET8_DATA_DIR=./CP1-DATASET
TILE_SIZE=512
BATCH_SIZE=8
