# ===== Database =====
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=capstone_flood_mapping

# ===== FastAPI Server =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
USE_STUB=true

# ===== Model Checkpoints =====
MODEL_CHECKPOINT_DIR=./checkpoints
O2_BASELINE_WEIGHTS=./checkpoints/unet_net_best.pth
O3_FUSION_WEIGHTS=./checkpoints/fusion_net_best.pth

# ===== Compute =====
CUDA_VISIBLE_DEVICES=0
WANDB_PROJECT=capstone-flood-mapping

# ===== Dataset =====
SPACENET8_DATA_DIR=./CP1-DATASET
TILE_SIZE=512
BATCH_SIZE=8
